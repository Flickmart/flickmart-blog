{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite"],
  "linter": {
    "rules": {
      "nursery": {
        "useConsistentTypeDefinitions": "off"
      },
      "suspicious": {
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["assert", "error", "info", "warn"]
          }
        },
        "noUnknownAtRules": "info"
      },
      "correctness": {
        "useParseIntRadix": "off"
      },
      "style": {
        "noMagicNumbers": "info",
        "useTemplate": "off"
      }
    }
  }
}
