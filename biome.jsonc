{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite",
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react"
  ],
  "linter": {
    "rules": {
      "nursery": {
        "useConsistentTypeDefinitions": "off"
      },
      "suspicious": {
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": [
              "assert",
              "error",
              "info",
              "warn"
            ]
          }
        },
        "noUnknownAtRules": "info"
      },
      "correctness": {
        "useParseIntRadix": "off"
      },
      "style": {
        "noMagicNumbers": "info",
        "useTemplate": "off"
      }
    }
  }
}